{
  "name": "codetantra-ai",
  "displayName": "CodeTantra AI",
  "version": "1.5.1",
  "description": "AI-assisted coding help for CodeTantra exercises, using your own Gemini or OpenAI API key.",
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "codetantra",
    "ai-coding-assistant",
    "gemini-api",
    "openai-api",
    "plasmo",
    "typescript",
    "react",
    "browser-extension"
  ],
  "author": "amandotyadav <https://github.com/amandotyadav>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/amandotyadav/codetantra-ai.git"
  },
  "homepage": "https://github.com/amandotyadav/codetantra-ai#readme",
  "bugs": {
    "url": "https://github.com/amandotyadav/codetantra-ai/issues"
  },
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run typecheck && npm run format:check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "lucide-react": "^0.577.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-draggable": "^4.5.0",
    "tailwindcss": "3.4.1"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "postcss": "8.4.33",
    "prettier": "3.2.4",
    "typescript": "5.3.3",
    "vitest": "^2.1.9"
  },
  "manifest": {
    "host_permissions": [
      "*://*.codetantra.com/*",
      "https://generativelanguage.googleapis.com/*",
      "https://api.openai.com/*"
    ],
    "commands": {
      "toggle-codetantra-ai": {
        "suggested_key": {
          "default": "Ctrl+Shift+Y"
        },
        "description": "Toggle Codetantra AI Window"
      }
    },
    "permissions": [
      "activeTab",
      "storage"
    ]
  }
}
